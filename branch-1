import java.util.Scanner;

public class GrossSalary {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        final double EXTRA_PAYMENT = 100; // fixed 100 OMR

        System.out.print("Enter basic salary (OMR): ");
        double basicSalary = input.nextDouble();

        System.out.print("Enter allowance (OMR): ");
        double allowance = input.nextDouble();

        System.out.print("Enter bonus (OMR): ");
        double bonus = input.nextDouble();

        double grossSalary = basicSalary + allowance + bonus + EXTRA_PAYMENT;

        System.out.println("Gross salary = " + grossSalary + " OMR");

        input.close();
    }
}
